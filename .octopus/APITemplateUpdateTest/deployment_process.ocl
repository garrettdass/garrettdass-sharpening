step "run-a-script-cac" {
    name = "Run a Script CaC"
    properties = {
        Octopus.Action.TargetRoles = "Dev"
    }

    action {
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Template.Id = "ActionTemplates-1249"
            Octopus.Action.Template.Version = "7"
        }
        worker_pool_variable = ""
    }
}