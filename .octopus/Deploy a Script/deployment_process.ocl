step "Run a Script" {
    properties = {
        Octopus.Action.TargetRoles = "Test"
    }

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody =  <<-EOT
                               version=$(get_octopusvariable "Octopus.Release.Number")
                                configFolderPath=/etc/archlogs
                                configFilePath=$configFolderPath/localconfig.json
                                
                                sudo pwsh -noprofile -Command "
                                if (\$(Test-Path $configFilePath) -eq \$true) {
                                	try{
                                    	\$json = get-content $configFilePath | Out-String | ConvertFrom-Json
                                        \$json | Add-Member -Name \"CustomTags\" -value @{InstalledBy = \"Octopus\"; Version = \"$version\" } -MemberType NoteProperty
                                        \$json | ConvertTo-Json | Out-File $configFilePath -Encoding ascii
                                    }
                                    catch{
                                    	write_warning \"Could not add 'CustomTags', the process ended with an error: \$(\$_.Exception.Message)\"
                                    }  
                                } else {
                                	write-host \"File '$configFilePath' not found\"
                                }"
    EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool_variable = ""
    }
}
