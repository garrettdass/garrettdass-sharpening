step "manual-intervention-required" {
    name = "Manual Intervention Required"

    action {
        action_type = "Octopus.Manual"
        channels = ["emergency-yolo"]
        is_disabled = true
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "True"
            Octopus.Action.Manual.Instructions = "For Emergency Use Only"
            Octopus.Action.Manual.ResponsibleTeamIds = "global/everyone"
            Octopus.Action.RunOnServer = "false"
        }
        tenant_tags = ["Quote Tenants/NotMotivated", "Quote Tenants/RandomQuoters"]
    }
}

step "create-tenant-resource-groups" {
    name = "Create Tenant Resource Groups"

    action {
        action_type = "Octopus.AzurePowerShell"
        is_disabled = true
        properties = {
            Octopus.Action.Azure.AccountId = "azure-sharpening"
            Octopus.Action.Script.ScriptBody = <<-EOT
                $rg = $OctopusParameters["ResourceGroup.Name"]
                $location = $OctopusParameters["ResourceGroup.Location"]
                
                $OCTOPUS_PROJECT_NAME = $OctopusParameters["Octopus.Project.Name"]
                $OCTOPUS_SPACE_NAME = $OctopusParameters["Octopus.Space.Name"]
                $OCTOPUS_ENVIRONMENT_NAME = $OctopusParameters["Octopus.Environment.Name"]
                $OCTOPUS_PROJECT_ID = $OctopusParameters["Octopus.Project.Id"]
                $OCTOPUS_ENVIRONMENT_ID = $OctopusParameters["Octopus.Environment.Id"]
                $OCTOPUS_SPACE_ID = $OctopusParameters["Octopus.Space.Id"]
                $OCTOPUS_URL = $OctopusParameters["My.Octopus.Url"]
                
                if ([bool]::Parse($(az group exists -n $rg))) {
                	Write-Host "Resource Group with name '$rg' already exists"
                } else {
                	Write-Host "Creating Resource Group with name '$rg' in '$location'"
                	az group create --name $rg --location $location --tags "Octopus.Project.Name=$OCTOPUS_PROJECT_NAME" "Octopus.Space.Name=$OCTOPUS_SPACE_NAME" "Octopus.Environment.Name=$OCTOPUS_ENVIRONMENT_NAME" "Octopus.Project.Id=$OCTOPUS_PROJECT_ID" "Octopus.Environment.Id=$OCTOPUS_ENVIRONMENT_ID" "Octopus.Space.Id=$OCTOPUS_SPACE_ID" "Octopus.Url=$OCTOPUS_URL"
                }
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }
        worker_pool = "hosted-ubuntu"

        container {
            feed = "docker"
            image = "#{ExecutionContainer.Azure}"
        }
    }
}

step "configure-webapp-target" {
    name = "Configure WebApp target"

    action {
        action_type = "Octopus.AzureResourceGroup"
        is_disabled = true
        properties = {
            Octopus.Action.Azure.AccountId = "azure-sharpening"
            Octopus.Action.Azure.ResourceGroupDeploymentMode = "Incremental"
            Octopus.Action.Azure.ResourceGroupName = "#{ResourceGroup.Name}"
            Octopus.Action.Azure.ResourceGroupTemplate = <<-EOT
                {
                  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                  "contentVersion": "1.0.0.0",
                  "parameters": {
                    "webAppName": {
                      "type": "string",
                      "defaultValue": "[concat('webApp-', uniqueString(resourceGroup().id))]",
                      "minLength": 2,
                      "metadata": {
                        "description": "Web app name."
                      }
                    },
                    "location": {
                      "type": "string",
                      "defaultValue": "[resourceGroup().location]",
                      "metadata": {
                        "description": "Location for all resources."
                      }
                    },
                    "sku": {
                      "type": "string",
                      "defaultValue": "#{Offering.Tier.Name}",
                      "metadata": {
                        "description": "The SKU of App Service Plan."
                      }
                    },
                    "skuCode": {
                      "type": "string",
                      "defaultValue": "#{Offering.Tier.SKU}",
                      "metadata": {
                        "description": "The SKU Code of App Service Plan."
                      }
                    },
                    "linuxFxVersion": {
                      "type": "string",
                      "defaultValue": "DOTNETCORE|3.0",
                      "metadata": {
                        "description": "The Runtime stack of current web app"
                      }
                    },
                    "repoUrl": {
                      "type": "string",
                      "defaultValue": " ",
                      "metadata": {
                        "description": "Optional Git Repo URL"
                      }
                    },
                    "webAppRole": {
                      "type": "string",
                      "defaultValue": "WebApp",
                      "metadata": {
                        "description": "Role to tag the web app with"
                      }
                    }
                  },
                  "variables": {
                    "appServicePlanPortalName": "[concat('AppServicePlan-', parameters('webAppName'))]"
                  },
                  "resources": [
                    {
                      "type": "Microsoft.Web/serverfarms",
                      "apiVersion": "2020-06-01",
                      "name": "[variables('appServicePlanPortalName')]",
                      "location": "[parameters('location')]",
                      "sku": {
                        "tier": "[parameters('sku')]",
                        "name": "[parameters('skuCode')]"
                      },
                      "kind": "linux",
                      "properties": {
                        "reserved": true
                      }
                    },
                    {
                      "type": "Microsoft.Web/sites",
                      "apiVersion": "2020-06-01",
                      "name": "[parameters('webAppName')]",
                      "location": "[parameters('location')]",
                      "tags": {
                        "octopus-role": "GD-AppService",
                        "octopus-environment": "#{Octopus.Environment.Name}",
                        "octopus-tenant": "#{Octopus.Deployment.Tenant.Name}"
                      },
                      "dependsOn": [
                        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanPortalName'))]"
                      ],
                      "properties": {
                        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanPortalName'))]",
                        "siteConfig": {
                          "linuxFxVersion": "[parameters('linuxFxVersion')]"
                        },
                        "resources": [
                          {
                            "condition": "[contains(parameters('repoUrl'),'http')]",
                            "type": "sourcecontrols",
                            "apiVersion": "2020-06-01",
                            "name": "web",
                            "location": "[parameters('location')]",
                            "dependsOn": [
                              "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
                            ],
                            "properties": {
                              "repoUrl": "[parameters('repoUrl')]",
                              "branch": "master",
                              "isManualIntegration": true
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
                EOT
            Octopus.Action.Azure.ResourceGroupTemplateParameters = "{\"webAppName\":{\"value\":\"#{WebApp.Name}\"},\"location\":{\"value\":\"#{ResourceGroup.Location}\"},\"sku\":{\"value\":\"#{Offering.Tier.Name}\"},\"skuCode\":{\"value\":\"#{Offering.Tier.SKU}\"},\"linuxFxVersion\":{\"value\":\"DOTNETCORE|3.1\"},\"repoUrl\":{\"value\":\" \"},\"webAppRole\":{\"value\":\"QuotesAppService\"}}"
            Octopus.Action.Azure.TemplateSource = "Inline"
            OctopusUseBundledTooling = "False"
        }
        worker_pool = "hosted-ubuntu"

        container {
            feed = "docker"
            image = "#{ExecutionContainer.Azure}"
        }
    }
}

step "deploy-app-with-package" {
    name = "Deploy App with Package"
    properties = {
        Octopus.Action.TargetRoles = "GD-AppService"
    }

    action {
        action_type = "Octopus.AzureAppService"
        properties = {
            Octopus.Action.Azure.DeploymentType = "Package"
            Octopus.Action.EnabledFeatures = "Octopus.Features.JsonConfigurationVariables,Octopus.Features.ConfigurationTransforms,Octopus.Features.SubstituteInFiles"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.JsonConfigurationVariablesTargets = "appsettings.json"
            Octopus.Action.Package.PackageId = "#{PackageByTag}"
            OctopusUseBundledTooling = "False"
        }
        worker_pool = "hosted-ubuntu"

        container {
            feed = "docker"
            image = "#{ExecutionContainer.Azure}"
        }

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "#{PackageByTag}"
            properties = {
                SelectionMode = "immediate"
            }
        }
    }
}

step "deploy-app-with-package-beta-opt-in" {
    name = "Deploy App with Package - Beta Opt In"
    properties = {
        Octopus.Action.TargetRoles = "GD-AppService"
    }

    action {
        action_type = "Octopus.AzureAppService"
        channels = ["beta", "default"]
        properties = {
            Octopus.Action.Azure.DeploymentType = "Package"
            Octopus.Action.EnabledFeatures = "Octopus.Features.JsonConfigurationVariables,Octopus.Features.ConfigurationTransforms,Octopus.Features.SubstituteInFiles"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.JsonConfigurationVariablesTargets = "appsettings.json"
            Octopus.Action.Package.PackageId = "RandomQuotes"
            OctopusUseBundledTooling = "False"
        }
        tenant_tags = ["Quote Tenants/BetaQuotes"]
        worker_pool = "hosted-ubuntu"

        container {
            feed = "docker"
            image = "#{ExecutionContainer.Azure}"
        }

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "RandomQuotes"
            properties = {
                SelectionMode = "immediate"
            }
        }
    }
}

step "email-alert-with-auth" {
    name = "Email Alert with Auth"

    action {
        action_type = "Octopus.Email"
        channels = ["emergency-yolo"]
        properties = {
            Octopus.Action.Email.Body = "Authorized by #{Authorization}"
            Octopus.Action.Email.Subject = "Emergency deployment on #{Octopus.Release.Channel.Name}"
            Octopus.Action.Email.To = "garrett@octopus.com"
            Octopus.Action.RunOnServer = "false"
        }
    }
}

step "run-a-script-cac" {
    condition = "Always"
    name = "Run a Script CaC"
    properties = {
        Octopus.Action.TargetRoles = "Prod"
    }

    action {
        channels = ["default"]
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Template.Id = "ActionTemplates-1249"
            Octopus.Action.Template.Version = "2"
        }
        tenant_tags = ["Quote Tenants/RandomQuoters"]
        worker_pool_variable = ""
    }
}

step "create-tenant" {
    name = "Create Tenant"
    properties = {
        Octopus.Action.TargetRoles = "Dev"
    }

    action {
        channels = ["beta"]
        properties = {
            CloneTenantStep_OctopusUrl = "#{if Octopus.Web.ServerUri}#{Octopus.Web.ServerUri}#{else}#{Octopus.Web.BaseUrl}#{/if}"
            CloneTenantStep_SpaceId = "Spaces-222"
            CreateTenantStep_ApiKey = "#{AppSettings:AppVersion}"
            CreateTenantStep_ProjectEnvironments = "test"
            CreateTenantStep_TenantName = "Test"
            CreateTenantStep_TenantTags = "Test"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Template.Id = "ActionTemplates-2281"
            Octopus.Action.Template.Version = "4"
        }
        tenant_tags = ["TenantTag1/Tag1"]
        worker_pool_variable = ""
    }
}