variable "Authorization" {
    value "Not Required" {
        environment = ["prod"]

        prompt {
            description = "Input link to authorization"
            display_settings = {
                Octopus.ControlType = "SingleLineText"
            }
            label = "Authorization"
            required = true
        }
    }
}

variable "My.Octopus.ApiKey" {
    value {}
}

variable "My.Octopus.Url" {
    value {}
}

variable "PackageByTag" {
    value "NotMotivationalQuotes" {
        description = ""
        tenant_tag = ["Quote Tenants/NotMotivated"]
    }

    value "RandomQuotes" {
        tenant_tag = ["Quote Tenants/RandomQuoters"]
    }
}

variable "TestCert" {
    type = "Certificate"

    value "Certificates-721" {}
}

variable "TestAWSAcc" {
    type = "AmazonWebServicesAccount"

    value "aws-account" {}
}

variable "TestGCPAcc" {
    type = "GoogleCloudAccount"

    value "gcp-account" {}
}

variable "TestAzureAcc" {
    type = "AzureAccount"

    value "azure-sharpening" {}
}

variable "TestPool" {
    type = "WorkerPool"

    value "test-pool" {}
}