step "run-a-script" {
    name = "Run a Script"
    properties = {
        Octopus.Action.TargetRoles = "Test"
    }

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "artifactory-docker-test"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptFileName = "scriptfileinsideapackage.ps1"
            Octopus.Action.Script.ScriptSource = "Package"
        }
        worker_pool_variable = ""

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "artifactory-docker-test"
            properties = {
                SelectionMode = "immediate"
            }
        }

        packages "dummyservice" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "dummyservice"
            properties = {
                Extract = "False"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }
    }
}

step "run-an-aws-cli-script" {
    name = "Run an AWS CLI Script"

    action {
        action_type = "Octopus.AwsRunScript"
        properties = {
            Octopus.Action.Aws.AssumeRole = "False"
            Octopus.Action.Aws.Region = "US-east"
            Octopus.Action.AwsAccount.UseInstanceRole = "True"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = "write-host test"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = ""

        packages "artifactory-docker-test" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "artifactory-docker-test"
            properties = {
                Extract = "True"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }
    }
}

step "deploy-a-bicep-template" {
    name = "Deploy a Bicep template"
    package_requirement = "AfterPackageAcquisition"

    action {
        properties = {
            Octopus.Action.Azure.BicepTemplateSourceCode = <<-EOT
                param location string = resourceGroup().location
                param storageAccountName string = 'toylaunch${uniqueString(resourceGroup().id)}'
                
                resource storageAccount 'Microsoft.Storage/storageAccounts@2021-06-01' = {
                  name: storageAccountName
                  location: location
                  sku: {
                    name: 'Standard_LRS'
                  }
                  kind: 'StorageV2'
                  properties: {
                    accessTier: 'Hot'
                  }
                }
                EOT
            Octopus.Action.Azure.ResourceGroupDeploymentMode = "Incremental"
            Octopus.Action.Azure.ResourceGroupLocation = "GroupLocation"
            Octopus.Action.Azure.ResourceGroupName = "GroupName"
            Octopus.Action.Azure.TemplateSource = "Inline"
            Octopus.Action.RunOnServer = "true"
        }
        worker_pool_variable = ""
        action_type = "Octopus.AzureDeployBicepTemplate"
    }
}