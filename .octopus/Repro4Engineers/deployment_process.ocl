step "deploy-a-bicep-template" {
    name = "Deploy a Bicep template"
    package_requirement = "AfterPackageAcquisition"

    action {
        action_type = "deploy-a-bicep-template"
        properties = {
            OctopusUseBundledTooling = "False"
        }
        step_package_version = "1.0.2"
        worker_pool = "hosted-windows"

        container {
            feed = "docker"
            image = "octopusdeploy/worker-tools:5.2.0-windows.ltsc2019"
        }

        inputs {
            account = "Accounts-463"
            isCompleteMode = false
            name = "Deploy a Bicep Template"
            resourceGroup = "GD-Bicep-Test"
            resourceGroupLocation = ""

            templateSource {
                sourceCode = <<-EOT
                        resource exampleStorage 'Microsoft.Storage/storageAccounts@2021-02-01' = {
                          name: storageName
                          location: 'eastus'
                          sku: {
                            name: 'Standard_LRS'
                          }
                          kind: 'StorageV2'
                        }
                        EOT
                type = "sourceCode"
            }
        }
    }
}