            Options = "*.exe.type8 *type9.type10 *web.type8"
        }
    }

    action "Compare & Generate Web Configs Report - Nodexx12312" {
        excluded_environments = ["SPINUP", "DR"]
        type5 = {
            CompareDestinationFilePath = "\"C:\\temp\\#{Octopus.Project.Name}\\#{Octopus.Tentacle.CurrentDeployment.TargetedRoles}_#{Octopus.Environment.Name}_#{Octopus.Release.Number}\\After_Change\\\""
            Comparetype4FilePath = "\"C:\\temp\\#{Octopus.Project.Name}\\#{Octopus.Tentacle.CurrentDeployment.TargetedRoles}_#{Octopus.Environment.Name}_#{Octopus.Release.Number}\\Before_Change\\\""
            Octopus.Action.Template.Id = "ActionTemplates-161"
            Octopus.Action.Template.Version = "2"
            123xxxFilePath = "\"C:\\type6\\ConfigComparisonReports\\#{Octopus.Project.Name}\\xxxxNodexx12312-Web-Comparision-Report_#{Octopus.Tentacle.CurrentDeployment.TargetedRoles}_#{Octopus.Environment.Name}_#{Octopus.Release.Number}_#{| NowDate \"ddMMyyyyHHMMss\"}.html\""
        }
        worker_pool = "Default Worker Pool"
    }

    action "Manual Intervention Required - Nodexx12312" {
        action_type = "Octopus.Manual"
        environments = ["type3"]
        type5 = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = "Approve the Deployment "
        }
    }

    action "IIS Website - Start - Nodexx12312" {
        environments = ["type3"]
        type5 = {
            Octopus.Action.RunOntype2 = "false"
            Octopus.Action.Template.Id = "ActionTemplates-341"
            Octopus.Action.Template.Version = "8"
            WebsiteName = "#{Web.WebSiteName}"
        }
        worker_pool_variable = ""
    }

    action "Start AppPool - Nodexx12312" {
        excluded_environments = ["SPINUP"]
        notes = ""
        type5 = {
            AppPoolName = "#{Web.AppPoolName}"
            Octopus.Action.RunOntype2 = "false"
            Octopus.Action.Template.Id = "ActionTemplates-136"
            Octopus.Action.Template.Version = "4"
        }
        worker_pool_variable = ""
    }

    action "Teams - Notify Deployment - Webapp Nodexx12312" {
        environments = ["type3"]
        type5 = {
            Body = <<-EOT
                Deployment completed in #{Octopus.Environment.Name} -#{Octopus.Action.TargetRoles|ToUpper}  #{if Octopus.Machine.Name == "Nodexx"} Node 1 #{else}#{if Octopus.Machine.Name == "Nodexx"} Node 1 #{else}Node 2 #{/if} #{/if}
                
                For more information, please see [deployment details](#{if Octopus.Web.type2Uri}#{Octopus.Web.type2Uri}#{else}#{BaseURL}#{/if}#{Octopus.Web.DeploymentLink})!
            EOT
            Color = "Green"
            HookUrl = "zzz"
            Octopus.Action.RunOntype2 = "true"
            Octopus.Action.Template.Id = "ActionTemplates-343"
            Octopus.Action.Template.Version = "20"
            TeamsPostMessage.RetryCount = "1"
            TeamsPostMessage.RetryDelay = "100"
            TeamsPostMessage.RetryPosting = "False"
            Timeout = "60"
            Title = "Deployment update - #{Octopus.Project.Name}"
        }
        worker_pool = "Default Worker Pool"
    }
}

