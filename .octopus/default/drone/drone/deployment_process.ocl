step "Config compare - templatexxx_general_xyz123" {
    type5 = {
        Octopus.Action.TargetRoles = "general-type2"
    }

    action "template-1" {
        action_type = "Octopus.TentaclePackage"
        environments = ["SPINUP"]
        is_disabled = true
        type5 = {
            Octopus.Action.EnabledFeatures = "Octopus.Features.CustomDirectory,Octopus.Features.JsonConfigurationVariables"
            Octopus.Action.Package.CustomInstallationDirectory = "#{generaltype6}\\#{Octopus.Action.StepName}"
            Octopus.Action.Package.CustomInstallationDirectoryShouldBePurgedBeforeDeployment = "True"
            Octopus.Action.Package.DownloadOnTentacle = "True"
            Octopus.Action.Package.FeedId = "type1"
            Octopus.Action.Package.JsonConfigurationVariablesTargets = "#{Octopus.Action.Package.InstallationDirectoryPath}\\type7\\main\\123xxx\\*.type5"
            Octopus.Action.Package.PackageId = "template1"
        }
        worker_pool_variable = ""

        packages {
            acquisition_location = "ExecutionTarget"
            feed = "Maven Repos"
            package_id = "template 1"
            type5 = {
                SelectionMode = "immediate"
            }
        }
    }

    action "File System- Backup Properties file - beforechange" {
        environments = ["SPINUP"]
        is_disabled = true
        type5 = {
            destinationPath = "\\\\#{generaltype2}\\c$\\backup\\beforechange\\"
            Octopus.Action.Template.Id = "ActionTemplates"
            Octopus.Action.Template.Version = "4"
            sourcePath = "\\\\#{generaltype2_type3}\\c$\\app\\xxx.type5"
        }
    }

    action "File System- Backup Properties file - afterchange" {
        environments = ["SPINUP"]
        is_disabled = true
        type5 = {
            destinationPath = "\\\\#{generaltype2}\\c$\\backup\\afterchange\\"
            Octopus.Action.Template.Id = "ActionTemplates-
            Octopus.Action.Template.Version = "4"
            sourcePath = "\\\\#{generaltype2_type4}\\C$\\template2.type5"
        }
    }

    action "Compare files - type5" {
        environments = ["SPINUP"]
        is_disabled = true
        type5 = {
            CompareDestinationFilePath = "\"\\\\#{generaltype2}\\c$\\backup\\afterchange\\\""
            Comparetype4FilePath = "\"\\\\#{generaltype2}\\c$\\backup\\beforechange\\\""
            Octopus.Action.Template.Id = "ActionTemplates"
            Octopus.Action.Template.Version = "90"
            123xxxFilePath = "\"C:\\type6\\ConfigComparisonReports\\#{Octopus.Project.Name}\\#{Octopus.Project.Name}-Web-Comparision-Report_#{Octopus.Tentacle.CurrentDeployment.TargetedRoles}_#{Octopus.Environment.Name}_#{Octopus.Release.Number}_#{| NowDate \"ddMMyyyyHHMMss\"}.html\""
        }
        worker_pool = "Default Worker Pool"
    }
}

