    type5 = {
        Octopus.Action.TargetRoles = "db-server"
    }

    action "Create Backup Folder - Database" {
        excluded_environments = ["SPINUP"]
        notes = ""
        type5 = {
            FolderPath = "#{DB.DatabaseBackUpPath}"
            Octopus.Action.Template.Id = "ActionTemplates-124"
            Octopus.Action.Template.Version = "3"
        }
        worker_pool_variable = ""
    }

    action "Create custom installation Folder - Database -" {
        excluded_environments = ["SPINUP"]
        notes = ""
        type5 = {
            FolderPath = "#{DB.CustomInstallationDirectory}"
            Octopus.Action.Template.Id = "ActionTemplates-124"
            Octopus.Action.Template.Version = "3"
        }
        worker_pool_variable = ""
