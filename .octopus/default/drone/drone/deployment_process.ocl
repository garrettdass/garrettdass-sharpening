step "Email Notification - To approve the Release" {

    action {
        action_type = "Octopus.Email"
        environments = ["QA", "SPINUP"]
        type5 = {
            Octopus.Action.Email.Body = "#{MailBody}"
            Octopus.Action.Email.CC = "mail"
            Octopus.Action.Email.IsHtml = "True"
            Octopus.Action.Email.Subject = "Approve Release -#{Octopus.Project.Name} > #{Octopus.Release.Number}"
            Octopus.Action.Email.To = "#{if Octopus.Environment.Name == \"QA\"}xxx@xxx.com#{else}#{if Octopus.Environment.Name == \"SPINUP\"}xxx@xxx.com#{else}false #{/if} #{/if}"
        }
    }
}

step "Approve Release  - Release manager" {

    action {
        action_type = "Octopus.Manual"
        environments = ["SPINUP"]
        notes = "approve"
        type5 = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = "approve"
        }
    }
}

step "Approve Release  - QA" {

    action {
        action_type = "Octopus.Manual"
        environments = ["QA"]
        notes = "approve"
        type5 = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = "approve"
            Octopus.Action.Manual.ResponsibleTeamIds = "QA "
        }
    }
}

step "Approve Release " {

    action {
        action_type = "Octopus.Manual"
        environments = ["type3"]
        notes = "approve"
        type5 = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = "approve"
            Octopus.Action.Manual.ResponsibleTeamIds = "Release Managers"
        }
    }
}

step "Manual Intervention Required-approve" {

    action {
        action_type = "Octopus.Manual"
        environments = ["type3"]
        type5 = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = "Approve the Deployment "
        }
    }
}

step "Teams - Notify Team of start" {

    action {
        environments = ["type3"]
        type5 = {
            Body = "For more information, please see [deployment details](#{if Octopus.Web.type2Uri}#{Octopus.Web.type2Uri}#{else}#{OctopusBaseURL}#{/if}#{Octopus.Web.DeploymentLink})!"
            Color = "Green"
            HookUrl = "#{url}"
            Octopus.Action.RunOntype2 = "true"
            Octopus.Action.Template.Id = "ActionTemplates"
            Octopus.Action.Template.Version = "20"
            TeamsPostMessage.RetryCount = "1"
            TeamsPostMessage.RetryDelay = "100"
            TeamsPostMessage.RetryPosting = "False"
            Timeout = "60"
            Title = "#{Octopus.Project.Name} #{Octopus.Release.Number} started at  #{ | NowDate \"dddd MM/dd/yyyy HH:mm\" } in #{Octopus.Environment.Name}"
        }
        worker_pool = "Default Worker Pool"
    }
}

step "AzureDevOps - NS - Disable  Member VIP" {

    action {
        environments = ["type3"]
        type5 = {
            AzureDevopsCollectionName = "#{VsAzureDevopsCollectionName}"
            AzureDevopsKey = "#{VsAzureDevopsKey}"
            AzureDevopsProjectName = "#{VsAzureDevopsProjectName}"
            AzureDevopsReleaseEnvironment = "yyyy-Nodexx"
            AzureDevopsRelID = "#{varAzDevOpsWebRelID-NS}"
            AzureDevOpsURL = "#{VsAzureDevOpsURL}"
            AzureDevopsUser = "tfs"
            Octopus.Action.Template.Id = "ActionTemplates"
            Octopus.Action.Template.Version = "42"
        }
        worker_pool = "Default Worker Pool"
    }
}

step "AzureDevOps - NS - Disable - Nodexx VIP" {
    start_trigger = "StartWithPrevious"

    action {
        environments = ["type3"]
