step "Deploy a Package modified" {
    condition = "Always"
    properties = {
        Octopus.Action.TargetRoles = "Dev"
    }

    action {
        properties = {
            Octopus.Action.Package.FeedId = "Octopus Server (built-in)"
            Octopus.Action.Package.PackageId = "RandomQuotesOne"
            Octopus.Action.Template.Id = "ActionTemplates-241"
            Octopus.Action.Template.Version = "0"
            Package = "{\"PackageId\":\"RandomQuotesOne\",\"FeedId\":\"feeds-builtin\"}"
        }
        worker_pool_variable = ""

        packages {
            acquisition_location = "Server"
            feed = "Octopus Server (built-in)"
            package_id = "RandomQuotesOne"
            properties = {
                PackageParameterName = "Package"
                SelectionMode = "deferred"
            }
        }
    }
}

